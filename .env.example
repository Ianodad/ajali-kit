# Copy to .env.local and fill in. Never commit .env.local.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
AJALI_MOCK=0
NEXT_PUBLIC_SHOW_DEV=0
# Mirrors AJALI_MOCK for the Settings page's mock mode indicator: a server
# env var is invisible to the browser, so set this the same as AJALI_MOCK if
# you want Settings to show the right value. Not a secret either way.
NEXT_PUBLIC_MOCK_MODE=0
